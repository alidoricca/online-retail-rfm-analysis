<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="online_retail.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5393"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="rfm_segments" custom_title="0" dock_id="1" table="4,12:mainrfm_segments"/><dock_state state="000000ff00000000fd0000000100000002000001c0000002aefc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000001c00000012d00ffffff000001c00000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="raw_transactions" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="67"/><column index="3" value="280"/><column index="4" value="56"/><column index="5" value="210"/><column index="6" value="46"/><column index="7" value="75"/><column index="8" value="117"/><column index="9" value="117"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="rfm_base" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="75"/><column index="2" value="55"/><column index="3" value="66"/><column index="4" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="rfm_segments" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="75"/><column index="2" value="55"/><column index="3" value="66"/><column index="4" value="78"/><column index="5" value="54"/><column index="6" value="53"/><column index="7" value="56"/><column index="8" value="132"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE VIEW clean_transactions AS
SELECT *,
	CASE WHEN Invoice LIKE 'C%' THEN 1 ELSE 0 END AS IsCancellation,
	Quantity * Price AS LineTotal
FROM raw_transactions
WHERE
	Invoice NOT LIKE 'A%'
	AND NOT (Quantity &lt; 0 AND Invoice NOT LIKE 'C%')
	AND StockCode NOT IN ('TEST001', 'TEST002')
	AND Description NOT LIKE '%test%'
	AND Price &gt; 0;</sql><sql name="SQL 2*">SELECT COUNT(*) FROM clean_transactions</sql><sql name="SQL 3*">SELECT MAX(InvoiceDate) AS last_date 
FROM clean_transactions</sql><sql name="SQL 4*">CREATE VIEW rfm_base AS
SELECT
	CustomerID,
	CAST(julianday('2011-12-09 12:50:00') - julianday(MAX(InvoiceDate)) AS INTEGER) AS Recency,
	COUNT(DISTINCT Invoice) AS Frequency,
	SUM(LineTotal) AS Monetary
FROM clean_transactions
WHERE CustomerID IS NOT NULL
GROUP BY CustomerID;
</sql><sql name="SQL 5*">SELECT * FROM rfm_base LIMIT 10;</sql><sql name="SQL 6*">SELECT COUNT(*) AS customers_with_negative_monetary
FROM rfm_base
WHERE Monetary &lt; 0;</sql><sql name="SQL 7*">SELECT COUNT(*) AS total_customers FROM rfm_base;</sql><sql name="SQL 8*">CREATE VIEW rfm_scored AS
SELECT	
	CustomerID,
	Recency,
	Frequency,
	Monetary,
	NTILE(5) OVER (ORDER BY Recency DESC) AS R_Score,
	NTILE(5) OVER (ORDER BY Frequency ASC) AS F_Score,
	NTILE(5) OVER (ORDER BY Monetary ASC) AS M_Score
FROM rfm_base</sql><sql name="SQL 9*">SELECT * 
FROM rfm_scored
LIMIT 10;</sql><sql name="SQL 10"></sql><sql name="SQL 11*">SELECT
	MIN(Recency) AS min_recency,
	MAX(Recency) AS max_recency,
	AVG(Recency) AS avg_recency,
	MIN(Frequency) AS min_frequency,
	MAX(Frequency) AS max_frequency,
	AVG(Frequency) AS avg_frequency,
	MIN(Monetary) AS min_monetary,
	MAX(Monetary) AS max_monetary,
	AVG(Monetary) AS avg_monetary
FROM rfm_base</sql><sql name="SQL 12*">SELECT 
    Recency,
    Frequency,
    Monetary
FROM rfm_base
ORDER BY Monetary;
</sql><sql name="SQL 13*">SELECT 
    ntile_group,
    MIN(Monetary) AS min_in_group,
    MAX(Monetary) AS max_in_group,
    COUNT(*) AS customers_in_group
FROM (
    SELECT Monetary, NTILE(5) OVER (ORDER BY Monetary) AS ntile_group
    FROM rfm_base
)
GROUP BY ntile_group
ORDER BY ntile_group;</sql><sql name="SQL 14*">SELECT 
    ntile_group,
    MIN(Recency) AS min_in_group,
    MAX(Recency) AS max_in_group,
    COUNT(*) AS customers_in_group
FROM (
    SELECT Recency, NTILE(5) OVER (ORDER BY Recency) AS ntile_group
    FROM rfm_base
)
GROUP BY ntile_group
ORDER BY ntile_group;</sql><sql name="SQL 15*">SELECT 
    ntile_group,
    MIN(Frequency) AS min_in_group,
    MAX(Frequency) AS max_in_group,
    COUNT(*) AS customers_in_group
FROM (
    SELECT Frequency, NTILE(5) OVER (ORDER BY Frequency) AS ntile_group
    FROM rfm_base
)
GROUP BY ntile_group
ORDER BY ntile_group;</sql><sql name="SQL 16*">DROP VIEW IF EXISTS rfm_segments;

CREATE VIEW rfm_segments AS
SELECT *,
	CASE
		WHEN R_Score &gt;= 4 AND F_Score &gt;= 4 AND M_Score &gt;= 4 THEN 'Champions'
		WHEN R_Score &gt;= 3 AND F_Score &gt;= 3 AND M_Score &gt;= 3 THEN 'Loyal Customers'
        WHEN R_Score &gt;= 4 AND F_Score BETWEEN 2 AND 3 THEN 'Potential Loyalist'
        WHEN R_Score &gt;= 4 AND F_Score &lt;= 1 THEN 'New Customers'
        WHEN R_Score = 3 AND F_Score &lt;= 2 AND M_Score &lt;= 2 THEN 'Promising'
        WHEN R_Score = 3 AND F_Score &gt;= 3 THEN 'Needs Attention'
        WHEN R_Score = 2 AND F_Score BETWEEN 2 AND 3 THEN 'About to Sleep'
        WHEN R_Score &lt;= 2 AND F_Score &gt;= 4 AND M_Score &gt;= 4 THEN 'Cannot Lose Them'
        WHEN R_Score &lt;= 2 AND F_Score &gt;= 3 THEN 'At Risk'
        WHEN R_Score &lt;= 2 AND F_Score &lt;= 2 AND M_Score &gt;= 3 THEN 'Hibernating'
        WHEN R_Score &lt;= 2 AND F_Score &lt;= 2 AND M_Score &lt;= 2 THEN 'Lost'
        ELSE 'Uncategorized'
    END AS Segment
FROM rfm_scored;</sql><sql name="SQL 17*">SELECT 
	Segment,
	COUNT(*) AS customer_count
FROM rfm_segments
GROUP BY Segment
ORDER BY customer_count DESC;</sql><sql name="SQL 18*">SELECT
	Segment,
	COUNT(*) AS customer_count,
	SUM(Monetary) AS total_revenue,
	ROUND(AVG(Monetary), 2) AS revenue_per_customer
FROM rfm_segments
GROUP BY Segment
ORDER BY total_revenue DESC;</sql><current_tab id="17"/></tab_sql></sqlb_project>
